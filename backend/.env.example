# CORS liberado para o frontend Vite local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# String de conexão PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missao_vieira

# String de conexão do banco de testes E2E
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/missao_vieira_test

# Chave da OpenAI para respostas dinâmicas do endpoint /api/chat
OPENAI_API_KEY=your_openai_api_key

# Modelo OpenAI usado no chat
OPENAI_MODEL=gpt-4o-mini

# Porta do servidor FastAPI
PORT=8000
